<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.schoolMarket.mapper.NotificationMapper">

    <!--
        显式 resultMap，重点看 is_read 这一行。

        【为什么必须显式写】
        Entity 字段名为 read，数据库列名为 is_read。
        若依赖驼峰自动映射，列 is_read → 属性 isRead，而实体上只有 read，
        不匹配 —— 且不会报任何错，字段永远是 null/false。
        显式声明后，映射关系一目了然，也彻底避开 Lombok 的 is 前缀陷阱。
    -->
    <resultMap id="NotificationMap" type="Notification">
        <id     column="id"          property="id"/>
        <result column="user_id"     property="userId"/>
        <result column="content"     property="content"/>
        <result column="is_read"     property="read"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="allColumns">
        id, user_id, content, is_read, create_time
    </sql>

    <!-- 动态条件：按是否已读筛选，read 为 null 时不加条件 -->
    <sql id="readFilter">
        <if test="read != null">
            AND is_read = #{read}
        </if>
    </sql>

    <insert id="insert" parameterType="Notification" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notification (user_id, content, is_read, create_time)
        VALUES (#{userId}, #{content}, #{read}, #{createTime})
    </insert>

    <select id="findPageByUser" resultMap="NotificationMap">
        SELECT <include refid="allColumns"/>
        FROM notification
        <where>
            user_id = #{userId}
            <include refid="readFilter"/>
        </where>
        ORDER BY create_time DESC, id DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="countByUser" resultType="long">
        SELECT COUNT(*)
        FROM notification
        <where>
            user_id = #{userId}
            <include refid="readFilter"/>
        </where>
    </select>

    <select id="countUnread" resultType="int">
        SELECT COUNT(*)
        FROM notification
        WHERE user_id = #{userId}
          AND is_read = 0
    </select>

    <!-- 带 is_read = 0 条件实现幂等：已读的通知重复标记影响 0 行 -->
    <update id="markRead">
        UPDATE notification
        SET is_read = 1
        WHERE id = #{id}
          AND user_id = #{userId}
          AND is_read = 0
    </update>

    <update id="markAllRead">
        UPDATE notification
        SET is_read = 1
        WHERE user_id = #{userId}
          AND is_read = 0
    </update>

</mapper>